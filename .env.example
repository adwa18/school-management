# ─────────────────────────────────────────────────────────────────────────────
# School Management System — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# ─── Database (Neon / Supabase PostgreSQL) ────────────────────────────────────
# Get from: https://neon.tech or https://supabase.com/dashboard
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/schooldb?schema=public
DIRECT_URL=postgresql://user:password@localhost:5432/schooldb?schema=public

# For local Docker development:
# DATABASE_URL=postgresql://schooladmin:schoolpass123@postgres:5432/schooldb?schema=public
# DIRECT_URL=postgresql://schooladmin:schoolpass123@postgres:5432/schooldb?schema=public

# ─── Redis (Upstash) ──────────────────────────────────────────────────────────
# Get from: https://console.upstash.com
# Leave empty to use in-memory cache fallback (not recommended for production)
UPSTASH_REDIS_REST_URL=https://YOUR-REDIS.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token-here

# ─── JWT Secrets ─────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_ACCESS_SECRET=CHANGE_ME_generate_secure_32_char_secret_here_abc123
JWT_REFRESH_SECRET=CHANGE_ME_generate_different_32_char_secret_here_xyz789
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Email (SendGrid) ────────────────────────────────────────────────────────
# Get API key from: https://app.sendgrid.com/settings/api_keys
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USER=apikey
EMAIL_PASS=SG.your-sendgrid-api-key-here
EMAIL_FROM=noreply@yourschool.edu
EMAIL_FROM_NAME=School Management System

# ─── SMS (Twilio) ─────────────────────────────────────────────────────────────
# Get from: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ─── Stripe (Fee Payments) ───────────────────────────────────────────────────
# Get test keys from: https://dashboard.stripe.com/test/apikeys
# Use TEST keys (sk_test_...) for development — no real charges
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_CURRENCY=usd

# ─── Cloudinary (File Storage) ───────────────────────────────────────────────
# Get from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─── Firebase Cloud Messaging (Push Notifications) ──────────────────────────
# Get from: https://console.firebase.google.com → Project settings → Cloud Messaging
FCM_SERVER_KEY=your-fcm-server-key

# ─── Security ─────────────────────────────────────────────────────────────────
# 32-character key for AES-256 encryption of sensitive data
# Generate with: openssl rand -hex 16
ENCRYPTION_KEY=CHANGE_ME_32_chars_exactly_here!!

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── Local Docker Database ───────────────────────────────────────────────────
POSTGRES_USER=schooladmin
POSTGRES_PASSWORD=schoolpass123
POSTGRES_DB=schooldb
REDIS_PASSWORD=redispass123

# ─── Frontend (Next.js) ──────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_APP_NAME=School Management System

# ─── Vercel (Frontend deployment) ────────────────────────────────────────────
# Set via `vercel env` CLI or Vercel dashboard — do NOT put in .env
# VERCEL_TOKEN=your-vercel-token
# VERCEL_ORG_ID=your-org-id
# VERCEL_PROJECT_ID=your-project-id

# ─── GitHub Actions Secrets (set in repo settings, not .env) ─────────────────
# VERCEL_TOKEN — Vercel CLI token
# RENDER_DEPLOY_HOOK — Render deploy hook URL
# DATABASE_URL — Production database URL
# All other secrets above
